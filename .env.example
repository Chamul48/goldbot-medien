# Goldbot – geheime Schlüssel. Kopieren nach .env (liegt nie im Repo) und nur ausfüllen, was du nutzt.
# Bereits gesetzte Windows-Umgebungsvariablen haben Vorrang. Goldbot zeigt die Werte nie an.

# KI über Claude (optional). Ohne Schlüssel nimmt Goldbot die lokale KI (Ollama).
# Schlüssel unter https://console.anthropic.com/ – oder Desktop-Verknüpfung „Goldbot KI-Key einrichten“.
ANTHROPIC_API_KEY=

# Echtes Bildmaterial für die Muster-Videos (kostenlos): https://pixabay.com/api/docs/ (angemeldet „Your API key“).
# Leer lassen, wenn config.yaml unter muster.pixabay_env auf eine andere .env zeigt (Standard: Gold-Bot).
PIXABAY_API_KEY=

# Aufträge zusätzlich per Telegram melden (optional): Bot bei @BotFather anlegen, Token hier,
# eigene Chat-ID in config.yaml unter notify.telegram_chat_id.
GOLDBOT_TELEGRAM_TOKEN=

# ---------- Shopify-Agent (shopify_agent/) ----------
# ANTHROPIC_API_KEY oben gilt auch für Chat und Autopilot (nicht nötig für --audit / --restore).
# Shopify: deine Shop-Adresse, z. B. dein-shop.myshopify.com
SHOPIFY_STORE=

# Zugang – EINE Variante ausfüllen und das # davor entfernen:
#  a) Neue App aus dem Dev Dashboard (seit 2026):
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
#  b) Alte eigene App mit festem Token:
# SHOPIFY_ACCESS_TOKEN=shpat_

# SHOPIFY_API_VERSION=2026-10


# Optional
# SHOPIFY_AGENT_MODEL=claude-opus-5-5
# MEDIA_DIR=social
