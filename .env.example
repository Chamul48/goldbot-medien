# Kopie als .env speichern und die Werte eintragen (Zeilen mit # werden ignoriert).

# Shopify: deine Shop-Adresse (die mit .myshopify.com)
SHOPIFY_STORE=dein-shop.myshopify.com

# Zugang – EINE Variante ausfüllen und das # davor entfernen:
#  a) Neue App aus dem Dev Dashboard (seit 2026):
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
#  b) Alte eigene App mit festem Token:
# SHOPIFY_ACCESS_TOKEN=shpat_

SHOPIFY_API_VERSION=2026-10

# Nur für Chat und Autopilot nötig (nicht für --audit / --restore):
# ANTHROPIC_API_KEY=sk-ant-

# Optional
# SHOPIFY_AGENT_MODEL=claude-opus-5-5
# MEDIA_DIR=social
